<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edos.jarvis</string>
  <key>ProgramArguments</key>
  <array>
    <string>__JARVIS_DIR__/ops/run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__JARVIS_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- A crash loop (e.g. ANTHROPIC_API_KEY set) waits between attempts instead of spinning. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__DATA_DIR__/logs/jarvis.log</string>
  <key>StandardErrorPath</key>
  <string>__DATA_DIR__/logs/jarvis.log</string>
</dict>
</plist>
